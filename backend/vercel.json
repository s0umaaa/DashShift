{
    "version": 2,
    "builds": [
      {
        "src": "api/index.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "^/jobs(?:/.*)?$",
        "dest": "api/index.js"
      },
      {
        "src": "^/.*$",
        "status": 404,
        "dest": "api/404.js"
      }
    ]
  }