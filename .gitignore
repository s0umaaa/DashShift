cat << 'EOF' > .gitignore
# Dependencies
node_modules/
*/node_modules/

# Build outputs
dist/
build/
.vite/
*/.vite/

# Environment files
.env
.env.local
.env.production

# OS generated files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Temporary files
.tmp/
temp/
git_history_backup.txt
pnpm-lock.yaml
backend/package-lock.json
backend/tsconfig.json

# Public folder (uploaded manually)
public/
EOFpublic/
.vercel
